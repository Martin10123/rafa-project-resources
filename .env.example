VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Usa una de las dos (anon = publishable):
VITE_SUPABASE_ANON_KEY=your_anon_key
# VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key

# URL pública del frontend (QR absolutos, PWA). En local: http://localhost:5173
VITE_APP_URL=http://localhost:5173

# Edge Function checkin (secrets en Supabase Dashboard → Edge Functions)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# ALLOWED_EMAIL_DOMAIN=tecnocomfenalco.edu.co
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
